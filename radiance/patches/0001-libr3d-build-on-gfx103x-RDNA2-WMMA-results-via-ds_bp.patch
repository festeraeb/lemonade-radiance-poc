 libr3d/r3d_common.h     |  41 +++++++++--
 libr3d/r3d_rows.cpp     |   2 +-
 libr3d/r3d_wmma_rdna2.h | 150 ++++++++++++++++++++++++++++++++++++++++
 libr3d/r3dh_wmma.h      |   9 +++
 5 files changed, 197 insertions(+), 7 deletions(-)
 create mode 100644 libr3d/r3d_wmma_rdna2.h

